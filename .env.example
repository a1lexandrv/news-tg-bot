# Telegram. Leave empty to run without publishing (no polling, no channel posts).
# BOT_TOKEN comes from @BotFather, CHANNEL_ID looks like @my_channel.
BOT_TOKEN=
CHANNEL_ID=

# OpenAI. Leave empty to skip AI filtering.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://ainews:ainews@localhost:5432/ainews
# Set to true for managed Postgres that requires TLS (Neon, Supabase, Railway public URL)
DB_SSL=false

# Runtime settings
MIN_HYPE_SCORE=6
FETCH_INTERVAL_MINUTES=180
NEWS_PER_DAY_LIMIT=15
# IANA timezone that defines where the "day" starts for NEWS_PER_DAY_LIMIT
DAY_BOUNDARY_TIMEZONE=UTC
ADMIN_USER_IDS=
